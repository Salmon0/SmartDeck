# Скопируйте в .env и поправьте значения
DATABASE_URL=sqlite:///./smartdeck.db
SECRET_KEY=замените-на-длинную-случайную-строку
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=10
MAX_CARDS_PER_MATERIAL=60
CORS_ORIGINS=*
# Генерация карточек через OpenAI. Без ключа работает эвристический генератор.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
