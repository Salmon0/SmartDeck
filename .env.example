# Скопируйте в .env для локальной разработки.
# Для Supabase возьмите URL в Project → Connect → Session pooler (порт 5432).
# Храните боевой URL в настройках хостинга, не в Android-приложении и не в Git.
DATABASE_URL=sqlite:///./smartdeck.db
SECRET_KEY=замените-на-длинную-случайную-строку
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=./storage
MAX_UPLOAD_MB=10
MAX_CARDS_PER_MATERIAL=60
CORS_ORIGINS=*
# Укажите ollama, чтобы использовать локальную Ollama на компьютере с backend.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=4096
# При LLM_PROVIDER=openai используется OpenAI; иначе можно выбрать heuristic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
